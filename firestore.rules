rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Announcements Rules
    match /announcements/{announcementId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      
      // Comments (Deferred feature, but allow read for now)
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAuthenticated(); // Refine later
      }
    }

    // Users Rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
